<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>OpenTimestamps</RootNamespace>
    <AssemblyName>OpenTimestamps</AssemblyName>
    <PackageId>OpenTimestamps</PackageId>
    <Description>A native .NET 9 implementation of the OpenTimestamps protocol for creating, parsing, upgrading, and verifying detached timestamp proofs anchored in the Bitcoin blockchain.</Description>
    <PackageTags>opentimestamps;ots;bitcoin;timestamp;blockchain;sha256;merkle</PackageTags>
    <Version>0.1.0</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1707;CA1303</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenTimestamps.Tests" />
    <InternalsVisibleTo Include="OpenTimestamps.IntegrationTests" />
  </ItemGroup>

</Project>
