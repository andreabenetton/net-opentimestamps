<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      Multi-target so the packed dotnet tool runs on the .NET 9 or .NET 10
      runtime. Running this project with dotnet run requires a framework argument.
    -->
    <TargetFramework />
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <RootNamespace>OpenTimestamps.Cli</RootNamespace>
    <AssemblyName>ots</AssemblyName>
    <PackageId>OpenTimestamps.Cli</PackageId>
    <Description>Command-line client for the OpenTimestamps protocol — stamp, verify, upgrade, and inspect detached .ots proofs.</Description>
    <PackageTags>opentimestamps;ots;cli;bitcoin;timestamp</PackageTags>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ots</ToolCommandName>
    <NoWarn>$(NoWarn);CA1303;CA2007</NoWarn>
    <RootNamespace>OpenTimestamps.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenTimestamps\OpenTimestamps.csproj" />
  </ItemGroup>

</Project>
