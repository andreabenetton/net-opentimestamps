<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>OpenTimestamps</RootNamespace>
    <AssemblyName>OpenTimestamps</AssemblyName>
    <PackageId>OpenTimestamps</PackageId>
    <Description>A native .NET 10 implementation of the OpenTimestamps protocol for creating, parsing, upgrading, and verifying detached timestamp proofs anchored in the Bitcoin blockchain.</Description>
    <PackageTags>opentimestamps;ots;bitcoin;timestamp;blockchain;sha256;merkle</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1707;CA1303</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenTimestamps.Tests" />
    <InternalsVisibleTo Include="OpenTimestamps.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
